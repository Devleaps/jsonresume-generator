{
  "name": "jsonresume-generator",
  "version": "1.0.0",
  "description": "A GitHub Action to validate and render JSON Resume files",
  "main": "dist/index.js",
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "build:watch": "rollup --config rollup.config.mjs -w",
    "lint": "eslint --config eslint.config.mjs .",
    "lint:fix": "eslint --config eslint.config.mjs . --fix",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,yml,yaml,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,json,yml,yaml,md}'",
    "all": "npm run build && npm run format && npm run lint"
  },
  "keywords": [
    "github-action",
    "jsonresume",
    "resume",
    "cv"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "glob": "^8.1.0",
    "js-yaml": "^4.1.0",
    "jsonresume-theme-devleaps": "file:devleaps",
    "jsonresume-theme-eloquent": "^5.0.0",
    "puppeteer": "^22.15.0",
    "resumed": "^3.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "rollup": "^4.9.6",
    "tslib": "^2.6.2",
    "typescript": "^5.8.2"
  }
}
